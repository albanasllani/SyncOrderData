<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <service id="SyncOrderData\Subscriber\OrderShippedSubscriber">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="Symfony\Component\Messenger\MessageBusInterface"/>
            <argument type="service" id="Psr\Log\LoggerInterface"/>
            <argument type="service" id="SyncOrderData\Service\WebhookService"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="monolog.logger"/>

            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="SyncOrderData\Service\WebhookService">
            <argument type="service" id="monolog.logger"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="Symfony\Component\Messenger\MessageBusInterface"/>

        </service>

        <service id="SyncOrderData\Core\Content\Flow\Dispatching\Action\SendOrderStatusUpdateAction">
            <argument type="service" id="SyncOrderData\Service\WebhookService"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="Symfony\Component\Messenger\MessageBusInterface"/>
            <tag name="kernel.event_subscriber"/>
            <tag name="flow.action" priority="600" key="action.send_order_status_update"/>
        </service>

        <service id="SyncOrderData\Core\Content\Flow\Subscriber\FlowSubscriber">
            <argument type="service" id="Shopware\Core\Framework\Event\BusinessEventCollector"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="SyncOrderData\MessageQueue\Handler\OrderWebhookHandler">
            <argument type="service" id="SyncOrderData\Service\WebhookService"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="monolog.logger"/>

            <tag name="messenger.message_handler"/>
        </service>


    </services>
</container>